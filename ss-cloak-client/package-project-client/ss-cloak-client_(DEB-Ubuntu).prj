[NAME]
name=ss-cloak-client

[VERSION]
version=0.5

[RELEASE]
release=0.mrx10

[GROUP]
group=Accessibility

[DESCRIPTION]
0=Shadowsocks-Rust + Cloak obfuscator Client
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=Shadowsocks-Rust + Cloak obfuscator Client

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/SS-Cloak

[LICENSE]
license=GPLv3

[DEPS]
deps=systemd libproxy1v5 libproxy1-plugin-gsettings libgtk2.0-0

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=1

[FILES]
0=/usr/local/bin/gost
1=/usr/local/bin/ssurl
2=/usr/local/bin/sslocal
3=/usr/local/bin/ssserver
4=/usr/local/bin/ssservice
5=/usr/local/bin/ck-client
6=/usr/local/bin/ck-server
7=/usr/bin/ss-cloak-client
8=/etc/systemd/user/gost.service
9=/usr/share/icons/ss-cloak-client.png
10=/etc/systemd/user/ss-cloak-client.service
11=/usr/share/applications/ss-cloak-client.desktop
12=/usr/share/ss-cloak-client/
13=/usr/share/doc/ss-cloak-client/

[AFTERINSTALL]
0=#!/bin/bash
1=
2=systemctl daemon-reload

[AFTERREMOVE]
0=#!/bin/bash
1=
2=systemctl daemon-reload

[URL32]
url32=https://github.com/AKotov-dev/SS-Cloak

[PROGRAMNAME]
programname=SS-Cloak-Client

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.4

